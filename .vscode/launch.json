{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "testclient (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "",
      "windows": {
        "program": "${workspaceFolder}/build/testclient/testclient.exe",
      },
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    },
    {
      "name": "tcutil fetch-telemetry --listen: 0.05",
      "type": "debugpy",
      "request": "launch",
      "module": "truckconnect_util",
      "args": [
        "fetch-telemetry",
        "${input:telemetry_id}",
        "${input:hostname}",
        "0.05"
      ]
    },
    {
      "name": "tcutil fetch-definition --listen: 0.05",
      "type": "debugpy",
      "request": "launch",
      "module": "truckconnect_util",
      "args": [
        "fetch-definition",
        "${input:definition_id}",
        "${input:hostname}",
        "0.05"
      ]
    }
  ],
  "inputs": [
    {
        "id": "telemetry_id",
        "type": "promptString",
        "description": "Telemetry ID",
        "default": "Invalid"
    },
    {
        "id": "definition_id",
        "type": "promptString",
        "description": "Definition ID or Alias",
        "default": ""
    },
    {
        "id": "hostname",
        "type": "promptString",
        "description": "Hostname",
        "default": "localhost"
    }
  ]
}
